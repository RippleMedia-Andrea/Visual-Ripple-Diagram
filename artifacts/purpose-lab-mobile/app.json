{
  "expo": {
    "name": "Purpose Lab",
    "slug": "purpose-lab-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/purpose-lab-icon.png",
    "scheme": "purpose-lab-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.ripplelabs.purposelab",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.ripplelabs.purposelab",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/purpose-lab-icon.png",
        "backgroundColor": "#0F2A36"
      }
    },
    "splash": {
      "image": "./assets/images/purpose-lab-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F1E8"
    },
    "web": {
      "favicon": "./assets/images/purpose-lab-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Purpose Lab uses the microphone only when you tap record, so you can speak a reflection and review the transcript before sending."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}